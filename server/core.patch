+#include <memory>
+
+// The server inside a browser tab has no network: the game client runs in the same page and
+// its connections arrive as calls from the page (electrode_open/data/close), not as sockets.
+
+namespace MaNGOS
+{
+    // One connection from the page.
+    class PageConn
+    {
+        public:
+            virtual ~PageConn() {}
+            virtual void PageDeliver(const char* data, size_t length) = 0;  // bytes from the client
+            virtual void PageRemoteClosed() = 0;                             // the client closed it
+    };
+
+    namespace PageNet
+    {
+        typedef std::function<std::shared_ptr<PageConn>(uint32 /*id*/)> Factory;
+
+        void Listen(uint16 port, Factory factory);
+        void Unlisten(uint16 port);
+        void Send(uint32 id, const char* data, size_t length);  // bytes to the client
+        void Closed(uint32 id);                                 // the server closed it
+        void Forget(uint32 id);
+        void Notify(const char* name, const char* detail);      // an event for the page
+    }
+}
+
+#endif
+#endif
