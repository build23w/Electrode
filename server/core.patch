+* along with this program; if not, write to the Free Software
+* Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
+*/
+
+#ifdef __EMSCRIPTEN__
+
+#include "Network/PageNet.h"
+
+#include <emscripten.h>
+#include <emscripten/threading.h>
+
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+
+namespace
+{
+    std::mutex g_lock;
+    std::map<uint16, MaNGOS::PageNet::Factory> g_listeners;
+    std::map<uint32, std::weak_ptr<MaNGOS::PageConn>> g_conns;
+    uint32 g_nextId = 1;
+
+    std::shared_ptr<MaNGOS::PageConn> Find(uint32 id, bool erase)
+    {
+        std::lock_guard<std::mutex> guard(g_lock);
+        auto itr = g_conns.find(id);
+        if (itr == g_conns.end())
+            return nullptr;
+        std::shared_ptr<MaNGOS::PageConn> conn = itr->second.lock();
+        if (erase || !conn)
+            g_conns.erase(itr);
+        return conn;
+    }
+}
+
+void MaNGOS::PageNet::Listen(uint16 port, Factory factory)
+{
+    std::lock_guard<std::mutex> guard(g_lock);
+    g_listeners[port] = std::move(factory);
+}
+
+void MaNGOS::PageNet::Unlisten(uint16 port)
+{
+    std::lock_guard<std::mutex> guard(g_lock);
+    g_listeners.erase(port);
+}
+
+// The page's side lives on the thread that created the module: Module.pageNet = { data, closed, event }.
+// Calls from other threads are queued to it in order.
+
+void MaNGOS::PageNet::Send(uint32 id, const char* data, size_t length)
+{
+    if (!length)
+        return;
+    char* copy = static_cast<char*>(malloc(length));
+    if (!copy)
+        return;
+    memcpy(copy, data, length);
+    MAIN_THREAD_ASYNC_EM_ASM({
+        var bytes = HEAPU8.slice($1, $1 + $2);
+        _free($1);
+        Module['pageNet']['data']($0, bytes);
+    }, id, copy, length);
+}
+
+void MaNGOS::PageNet::Closed(uint32 id)
+{
+    Forget(id);
+    MAIN_THREAD_ASYNC_EM_ASM({ Module['pageNet']['closed']($0); }, id);
+}
+
+void MaNGOS::PageNet::Forget(uint32 id)
+{
+    std::lock_guard<std::mutex> guard(g_lock);
+    g_conns.erase(id);
+}
+
+void MaNGOS::PageNet::Notify(const char* name, const char* detail)
+{
+    MAIN_THREAD_ASYNC_EM_ASM({
+        var name = UTF8ToString($0);
+        var detail = UTF8ToString($1);
+        _free($0);
+        _free($1);
+        Module['pageNet']['event'](name, detail);
+    }, strdup(name), strdup(detail ? detail : ""));
+}
+
+extern "C"
+{
+    // A new connection to a port the server listens on. Returns its id, or 0.
+    EMSCRIPTEN_KEEPALIVE int electrode_open(int port)
+    {
+        MaNGOS::PageNet::Factory factory;
+        uint32 id;
+        {
+            std::lock_guard<std::mutex> guard(g_lock);
+            auto itr = g_listeners.find(uint16(port));
+            if (itr == g_listeners.end())
+                return 0;
+            factory = itr->second;
+            id = g_nextId++;
+        }
+        std::shared_ptr<MaNGOS::PageConn> conn = factory(id);
+        if (!conn)
+            return 0;
+        std::lock_guard<std::mutex> guard(g_lock);
+        g_conns[id] = conn;
+        return int(id);
+    }
+
+    EMSCRIPTEN_KEEPALIVE void electrode_data(int id, const char* data, int length)
+    {
+        if (length <= 0)
+            return;
+        if (std::shared_ptr<MaNGOS::PageConn> conn = Find(uint32(id), false))
+            conn->PageDeliver(data, size_t(length));
+    }
+
+    EMSCRIPTEN_KEEPALIVE void electrode_close(int id)
+    {
+        if (std::shared_ptr<MaNGOS::PageConn> conn = Find(uint32(id), true))
+            conn->PageRemoteClosed();
+    }
+}
+
+#endif
