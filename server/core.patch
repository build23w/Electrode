+* (at your option) any later version.
+*
+* This program is distributed in the hope that it will be useful,
+* but WITHOUT ANY WARRANTY; without even the implied warranty of
+* MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+* GNU General Public License for more details.
+*
+* You should have received a copy of the GNU General Public License
+* along with this program; if not, write to the Free Software
+* Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
+*/
+
+#ifndef MANGOSSERVER_PAGE_SOCKET
+#define MANGOSSERVER_PAGE_SOCKET
+
+// AsyncSocket and AsyncListener for a server that runs inside a browser tab: the same interface
+// as the Boost.Asio ones, with a byte queue filled by the page in place of a TCP socket.
+// Completion callbacks still run on the io_context's threads, one at a time per socket.
+
+#include "Platform/Define.h"
+#include <boost/asio.hpp>
+#include "Log/Log.h"
+#include "Network/PageNet.h"
+
+#include <atomic>
+#include <cstring>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace MaNGOS
+{
+    template <typename SocketType>
+    class AsyncSocket : public std::enable_shared_from_this<SocketType>, public PageConn
+    {
+        public:
+            typedef std::function<void(const boost::system::error_code&, std::size_t)> Callback;
+
+            AsyncSocket(boost::asio::io_context& io_context) : m_context(io_context), m_id(0), m_closed(true),
+                m_inboundPos(0), m_readBuffer(nullptr), m_readLength(0), m_untilBuffer(nullptr), m_untilDelimiter(0),
+                m_address("127.0.0.1"), m_remoteEndpoint("127.0.0.1:0"),
+                m_remoteAddress(boost::asio::ip::make_address("127.0.0.1")), m_remotePort(0)
+            {
+            }
+
+            virtual ~AsyncSocket()
+            {
+                if (m_id)
+                    PageNet::Forget(m_id);
+            }
+
+            void Read(char* buffer, size_t length, Callback&& callback)
+            {
+                std::unique_lock<std::mutex> guard(m_ioMutex);
+                if (m_closed)
+                {
+                    guard.unlock();
+                    Complete(std::move(callback), boost::asio::error::operation_aborted, 0);
+                    return;
+                }
+                m_readBuffer = buffer;
+                m_readLength = length;
+                m_untilBuffer = nullptr;
+                m_readCallback = std::move(callback);
+                TryComplete(guard);
+            }
+
+            void ReadUntil(std::string& buffer, char delimiter, Callback&& callback)
+            {
+                std::unique_lock<std::mutex> guard(m_ioMutex);
+                if (m_closed)
+                {
+                    guard.unlock();
+                    Complete(std::move(callback), boost::asio::error::operation_aborted, 0);
+                    return;
+                }
+                m_readBuffer = nullptr;
+                m_untilBuffer = &buffer;
+                m_untilDelimiter = delimiter;
+                m_readCallback = std::move(callback);
+                TryComplete(guard);
+            }
+
+            void ReadSkip(size_t skipSize, Callback&& callback)
+            {
+                std::shared_ptr<std::vector<uint8>> buffer = std::make_shared<std::vector<uint8>>(skipSize);
+                Read(reinterpret_cast<char*>(buffer->data()), skipSize, [callback, buffer](const boost::system::error_code& error, std::size_t read)
+                {
+                    callback(error, read);
+                });
+            }
+
+            void Write(const char* buffer, size_t length, Callback&& callback)
+            {
+                if (m_closed)
+                {
+                    Complete(std::move(callback), boost::asio::error::operation_aborted, 0);
+                    return;
+                }
+                PageNet::Send(m_id, buffer, length);
+                Complete(std::move(callback), boost::system::error_code(), length);
+            }
+
+            // called by the listener before Start
+            void PageAttach(uint32 id)
+            {
+                m_id = id;
+                m_closed = false;
+            }
+
+            bool Start()
+            {
+                OnOpen();
+                ProcessIncomingData();
+                return true;
+            }
+
+            void Close()
+            {
+                if (Shut(boost::asio::error::operation_aborted))
+                    PageNet::Closed(m_id);
+            }
+
+            virtual bool Deletable() const { return IsClosed(); }
+            bool IsClosed() const { return m_closed; }
+
+            boost::asio::ip::address GetRemoteIpAddress() const { return m_remoteAddress; }
+            uint16 GetRemotePort() const { return m_remotePort; }
+
+            std::string const& GetRemoteEndpoint() const { return m_remoteEndpoint; }
+            std::string const& GetRemoteAddress() const { return m_address; }
+
+            // PageConn
+            void PageDeliver(const char* data, size_t length) override
+            {
+                std::unique_lock<std::mutex> guard(m_ioMutex);
+                if (m_closed)
+                    return;
+                m_inbound.insert(m_inbound.end(), data, data + length);
+                TryComplete(guard);
+            }
+
+            void PageRemoteClosed() override
+            {
+                Shut(boost::asio::error::eof);
+            }
+
+        private:
+            virtual bool ProcessIncomingData() = 0;
+            virtual bool OnOpen() = 0;
+
+            void Complete(Callback&& callback, boost::system::error_code const& error, std::size_t count)
+            {
+                boost::asio::post(m_context, [callback = std::move(callback), error, count]() { callback(error, count); });
+            }
+
+            // marks the socket closed and fails the waiting read; false if it was closed already
+            bool Shut(boost::system::error_code const& error)
+            {
+                Callback callback;
+                {
+                    std::lock_guard<std::mutex> guard(m_ioMutex);
+                    if (m_closed)
+                        return false;
+                    m_closed = true;
+                    callback = std::move(m_readCallback);
+                    m_readCallback = nullptr;
+                    m_inbound.clear();
+                    m_inboundPos = 0;
+                }
+                if (callback)
+                    Complete(std::move(callback), error, 0);
+                return true;
+            }
+
+            // with m_ioMutex held: finish the waiting read if the queue now holds enough
+            void TryComplete(std::unique_lock<std::mutex>& guard)
+            {
+                if (!m_readCallback)
+                    return;
+                size_t available = m_inbound.size() - m_inboundPos;
+                size_t count;
+                if (m_untilBuffer)
+                {
+                    const char* begin = m_inbound.data() + m_inboundPos;
+                    const void* hit = available ? memchr(begin, m_untilDelimiter, available) : nullptr;
+                    if (!hit)
+                        return;
+                    count = size_t(static_cast<const char*>(hit) - begin) + 1;
+                    m_untilBuffer->append(begin, count);
+                }
+                else
+                {
+                    if (available < m_readLength)
+                        return;
+                    count = m_readLength;
+                    if (count)
+                        memcpy(m_readBuffer, m_inbound.data() + m_inboundPos, count);
+                }
+                m_inboundPos += count;
+                if (m_inboundPos == m_inbound.size())
+                {
+                    m_inbound.clear();
+                    m_inboundPos = 0;
+                }
+                else if (m_inboundPos > 65536)
+                {
+                    m_inbound.erase(m_inbound.begin(), m_inbound.begin() + m_inboundPos);
+                    m_inboundPos = 0;
+                }
+                Callback callback = std::move(m_readCallback);
+                m_readCallback = nullptr;
+                guard.unlock();
+                Complete(std::move(callback), boost::system::error_code(), count);
+            }
+
+            boost::asio::io_context& m_context;
+            uint32 m_id;
+            std::atomic<bool> m_closed;
+
+            std::mutex m_ioMutex;
+            std::vector<char> m_inbound;
+            size_t m_inboundPos;
+            char* m_readBuffer;
+            size_t m_readLength;
+            std::string* m_untilBuffer;
+            char m_untilDelimiter;
+            Callback m_readCallback;
+
+            std::string m_address;
+            std::string m_remoteEndpoint;
+            boost::asio::ip::address m_remoteAddress;
+            uint16 m_remotePort;
+    };
+
+    template <typename SocketType>
+    class AsyncListener
+    {
+        public:
+            AsyncListener(boost::asio::io_context& io_context, std::string const& /*bindIp*/, unsigned short port) : m_port(port)
+            {
+                boost::asio::io_context* context = &io_context;
+                PageNet::Listen(port, [context](uint32 id) -> std::shared_ptr<PageConn>
+                {
+                    std::shared_ptr<SocketType> connection = std::make_shared<SocketType>(*context);
+                    connection->PageAttach(id);
+                    boost::asio::post(*context, [connection]() { connection->Start(); });
+                    return connection;
+                });
+            }
+
+            ~AsyncListener()
+            {
+                PageNet::Unlisten(m_port);
+            }
+
+        private:
+            uint16 m_port;
+    };
+}
+
+#endif
