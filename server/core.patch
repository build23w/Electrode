+
+    // Tables of the characters database whose rows a server reads into memory when it starts.
+    const char* const HELD_IN_MEMORY[] =
+    {
+        "auction", "corpse", "groups", "group_member", "group_instance", "guild", "guild_member", "guild_rank",
+        "instance", "instance_reset", "item_text", "gm_tickets"
+    };
+
+    bool Differ(Database& db, const char* table)
+    {
+        if (db.PQuery("SELECT 1 FROM (SELECT * FROM main.%s EXCEPT SELECT * FROM incoming.%s) LIMIT 1", table, table))
+            return true;
+        return bool(db.PQuery("SELECT 1 FROM (SELECT * FROM incoming.%s EXCEPT SELECT * FROM main.%s) LIMIT 1", table, table));
+    }
+
+    // The rows of every table of `db` are replaced by those of the database file `file`, which
+    // the page put there: the same database as another player's browser last saved it. The
+    // server keeps running; nobody is playing on it.
+    //   "ok"     done (or there was no such file)
+    //   "stale"  rows this server holds in memory differ: only a server started afresh has them right
+    //   "failed"
+    const char* AdoptFile(Database& db, const char* file, bool checkHeld)
+    {
+        if (access(file, F_OK) != 0)
+            return "ok";
+
+        const char* answer = "ok";
+        // One of the database's connections reads, the other writes: both are shown the file.
+        db.PQuery("ATTACH DATABASE '%s' AS incoming", file);
+        if (!db.DirectPExecute("ATTACH DATABASE '%s' AS incoming", file))
+            answer = "failed";
+        else
+        {
+            if (checkHeld)
+            {
+                for (const char* table : HELD_IN_MEMORY)
+                {
+                    if (Differ(db, table))
+                    {
+                        answer = "stale";
+                        break;
+                    }
+                }
+            }
+            if (answer[0] == 'o')
+            {
+                std::vector<std::string> tables;
+                {
+                    auto result = db.Query("SELECT name FROM incoming.sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%'");
+                    if (result)
+                    {
+                        do
+                            tables.push_back(result->Fetch()[0].GetCppString());
+                        while (result->NextRow());
+                    }
+                }
+                for (auto const& table : tables)
+                {
+                    if (!db.DirectPExecute("DELETE FROM main.\"%s\"", table.c_str()) ||
+                            !db.DirectPExecute("INSERT INTO main.\"%s\" SELECT * FROM incoming.\"%s\"", table.c_str(), table.c_str()))
+                    {
+                        answer = "failed";
+                        break;
+                    }
+                }
+            }
+            db.DirectExecute("DETACH DATABASE incoming");
+        }
+        db.Query("DETACH DATABASE incoming");
+        remove(file);
+        return answer;
+    }
+
+    const char* Adopt()
+    {
+        if (sWorld.GetActiveAndQueuedSessionCount() > 0)
+            return "busy";
+        const char* characters = AdoptFile(CharacterDatabase, "/db/incoming-characters.sqlite", true);
+        if (characters[0] != 'o')
+        {
+            remove("/db/incoming-realmd.sqlite");
+            return characters;
+        }
+        const char* accounts = AdoptFile(LoginDatabase, "/db/incoming-realmd.sqlite", false);
+        if (accounts[0] != 'o')
+            return accounts;
+        // As a server does when it starts: nobody is in the world, and new characters, items and
+        // mails are numbered after the highest ones there are.
+        CharacterDatabase.DirectExecute("UPDATE characters SET online = 0 WHERE online <> 0");
+        LoginDatabase.DirectExecute("UPDATE account SET active_realm_id = 0 WHERE active_realm_id <> 0");
+        sObjectMgr.SetHighestGuids();
+        sObjectMgr.LoadPetNumber();
+        return "ok";
+    }
+
+    std::mutex g_tileLock;
+    std::vector<std::array<uint32, 3>> g_tiles;     // movement-map tiles that are ready to load
+    std::vector<std::pair<std::string, std::string>> g_merges;  // accounts whose characters move to another
+}
+
+// Called by the world thread once per loop, between two world updates (no map is being updated).
+void PageHostTick()
+{
+    std::vector<std::array<uint32, 3>> tiles;
+    {
+        std::lock_guard<std::mutex> guard(g_tileLock);
+        tiles.swap(g_tiles);
+    }
+    for (auto const& tile : tiles)
+        MMAP::PageLoadTile(sWorld.GetDataPath(), tile[0], int32(tile[1]), int32(tile[2]));
+
+    std::vector<std::pair<std::string, std::string>> merges;
+    {
+        std::lock_guard<std::mutex> guard(g_tileLock);
+        merges.swap(g_merges);
+    }
+    for (auto const& merge : merges)
+    {
+        uint32 from = sAccountMgr.GetId(merge.first);
+        uint32 to = sAccountMgr.GetId(merge.second);
+        if (from && to && from != to)
+            CharacterDatabase.DirectPExecute("UPDATE characters SET account = %u WHERE account = %u", to, from);
+        MaNGOS::PageNet::Notify("merged", merge.first.c_str());
+    }
+
+    if (int tag = g_adoptWanted.exchange(0))
+    {
+        std::string detail = std::to_string(tag) + "\n" + Adopt();
+        MaNGOS::PageNet::Notify("adopted", detail.c_str());
+    }
+
+    if (!g_snapshotWanted.exchange(false))
+        return;
+
+    // Consistent copies of the two databases that change in play; the page stores them.
+    remove("/snapshot/characters.sqlite");
+    remove("/snapshot/realmd.sqlite");
+    bool ok = CharacterDatabase.DirectExecute("VACUUM INTO '/snapshot/characters.sqlite'");
+    ok = LoginDatabase.DirectExecute("VACUUM INTO '/snapshot/realmd.sqlite'") && ok;
+    MaNGOS::PageNet::Notify("snapshot", ok ? "ok" : "failed");
+}
+
+extern "C"
+{
+    EMSCRIPTEN_KEEPALIVE void electrode_stop()
+    {
+        World::StopNow(SHUTDOWN_EXIT_CODE);
+    }
+
+    // A console command, as typed at the server's own prompt. The output comes back as a
+    // "command" event: the tag, then "ok" or "failed", then the text, one per line.
+    EMSCRIPTEN_KEEPALIVE void electrode_command(int tag, const char* command)
+    {
+        std::shared_ptr<std::string> out = std::make_shared<std::string>();
+        sWorld.QueueCliCommand(new CliCommandHolder(0, SEC_CONSOLE, command,
+            [out](const char* text) { out->append(text); },
+            [out, tag](bool success)
+            {
+                std::string detail = std::to_string(tag) + "\n" + (success ? "ok" : "failed") + "\n" + *out;
+                MaNGOS::PageNet::Notify("command", detail.c_str());
+            }));
+    }
+
+    EMSCRIPTEN_KEEPALIVE void electrode_snapshot()
+    {
+        g_snapshotWanted = true;
+    }
+
+    // The page put the characters and accounts databases of the world, as its host last saved
+    // them, at /db/incoming-characters.sqlite and /db/incoming-realmd.sqlite: this server takes
+    // their rows in place of its own. Answered by an "adopted" event: the tag, then "ok",
+    // "stale" (start this server afresh instead), "busy" (somebody is playing here) or "failed".
+    EMSCRIPTEN_KEEPALIVE void electrode_adopt(int tag)
+    {
+        g_adoptWanted = tag;
+    }
+
+    // One player had two accounts in this world (one from running it, one from joining it): the
+    // characters of `from` go to `to`. Asked before anyone is in the world; answered by a "merged" event.
+    EMSCRIPTEN_KEEPALIVE void electrode_merge_account(const char* from, const char* to)
+    {
+        std::lock_guard<std::mutex> guard(g_tileLock);
+        g_merges.emplace_back(from, to);
+    }
+
+    // A movement-map tile the server asked for ("mmtile" event) is now in the data folder.
+    // x and y of -1: the whole map ("mmap" event) is.
+    EMSCRIPTEN_KEEPALIVE void electrode_mmap_tile(int map, int x, int y)
+    {
+        std::lock_guard<std::mutex> guard(g_tileLock);
+        g_tiles.push_back({ uint32(map), uint32(x), uint32(y) });
+    }
+}
+
+#endif
