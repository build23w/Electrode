+
+// In a browser tab every read of a file is a call from the server's thread to the thread that
+// owns the file system, and such a call costs far more than the read itself. The C library reads
+// 1 KB at a time, which makes loading terrain and collision models tens of thousands of calls.
+// Files opened for reading get a large buffer instead. The executable is linked with
+// --wrap=fopen,--wrap=fclose so every fopen in the program comes through here.
+
+#ifdef __EMSCRIPTEN__
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+
+namespace
+{
+    const size_t READ_BUFFER = 256 * 1024;
+    std::mutex g_lock;
+    std::unordered_map<FILE*, char*> g_buffers;
+}
+
+extern "C"
+{
+    FILE* __real_fopen(const char* path, const char* mode);
+    int __real_fclose(FILE* file);
+
+    FILE* __wrap_fopen(const char* path, const char* mode)
+    {
+        FILE* file = __real_fopen(path, mode);
+        if (file && mode && mode[0] == 'r' && !strchr(mode, '+'))
+        {
+            if (char* buffer = static_cast<char*>(malloc(READ_BUFFER)))
+            {
+                setvbuf(file, buffer, _IOFBF, READ_BUFFER);
+                std::lock_guard<std::mutex> guard(g_lock);
+                g_buffers[file] = buffer;
+            }
+        }
+        return file;
+    }
+
+    int __wrap_fclose(FILE* file)
+    {
+        char* buffer = nullptr;
+        {
+            std::lock_guard<std::mutex> guard(g_lock);
+            auto itr = g_buffers.find(file);
+            if (itr != g_buffers.end())
+            {
+                buffer = itr->second;
+                g_buffers.erase(itr);
+            }
+        }
+        int result = __real_fclose(file);
+        free(buffer);
+        return result;
+    }
+}
+
+#endif
